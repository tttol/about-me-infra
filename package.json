{
  "name": "about-me-infra",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && node --test dist/test/*.test.js",
    "cdk": "cdk",
    "synth:offline": "npm run build && node scripts/synth-offline.mjs",
    "check": "npm test && npm run synth:offline && npm audit --audit-level=low"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "aws-cdk": "2.1146.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1",
    "dotenv": "18.0.9"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1"
}
